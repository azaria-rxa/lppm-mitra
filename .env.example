# ===== Database =====
# Format: mysql://user:password@host:port/nama_database
DATABASE_URL="mysql://root:password@localhost:3306/sikap_lppm"

# ===== NextAuth =====
# Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET="ganti-dengan-string-random-yang-panjang"
NEXTAUTH_URL="http://localhost:3000"

# ===== Password akun default (dipakai seed) =====
SEED_ADMIN_EMAIL="admin@lppm.ac.id"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_PIMPINAN_EMAIL="pimpinan@lppm.ac.id"
SEED_PIMPINAN_PASSWORD="Pimpinan123!"

# ===== SMTP / Email (fitur notifikasi & reminder) =====
# Dev: gunakan Ethereal (https://ethereal.email) atau SMTP lokal.
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SIKAP LPPM <no-reply@sikap-lppm.ac.id>"

# ===== Cron / Reminder (dijalankan manual atau scheduler eksternal) =====
# Endpoint /api/reminder hanya diproses jika header ini cocok
REMINDER_CRON_SECRET="ganti-dengan-secret-cron"

# ===== Rate limiting survei (per IP, per menit) =====
RATE_LIMIT_MAX="5"
